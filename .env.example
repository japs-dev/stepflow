# ==============================================================================
# StepFlow Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to customize your environment.

# ------------------------------------------------------------------------------
# Storage & Workspace Paths
# ------------------------------------------------------------------------------
# STEPFLOW_PROJECTS_DIR: Custom path for StepFlow workspace storage.
# If omitted, StepFlow defaults to ~/Documents/StepFlow (or ~/StepFlow on Linux).
# Example for shared enterprise network drive:
# STEPFLOW_PROJECTS_DIR=/Volumes/TeamShared/StepFlow

# ------------------------------------------------------------------------------
# Development & Debugging
# ------------------------------------------------------------------------------
# STEPFLOW_DEBUG: Enable verbose diagnostic logging to console and logs/runtime.log.
# Values: 1, true, 0, false (Default: 0)
STEPFLOW_DEBUG=0

# PORT: Local development server port for Vite.
# Default: 5173
PORT=5173
